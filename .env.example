# Optional. Without keys the app uses the local fallback.
# Copy to .env.local. Set both KEY and MODEL to enable a provider.
# OpenAI model must support JSON Schema structured outputs and temperature.
OPENAI_API_KEY=
OPENAI_MODEL=
# NVIDIA model must support nvext.guided_json (NIM structured generation).
NVIDIA_API_KEY=
NVIDIA_MODEL=
# NVIDIA NIM endpoint is defined in lib/ai/provider.ts:
# https://integrate.api.nvidia.com/v1
